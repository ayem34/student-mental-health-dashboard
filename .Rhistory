"text",
x     = min(df$age, na.rm = TRUE) + 0.3,
y     = 2.58,
label = "Seuil critique = 2.5",
size  = 3,
color = "#E11D48",
hjust = 0
) +
labs(
title   = "Profils étudiants à risque",
subtitle = "Dépression + CGPA < 2.5  |  Taille = CGPA",
x       = "Âge",
y       = "CGPA",
caption = paste0(nrow(df), " étudiant(s) identifié(s)")
) +
theme_dash()
}
# =====================================================
# ONGLET GEOM GGPROTO — utilise geom_mentalhealth()
# défini dans custom_geom.R
# =====================================================
plot_custom_geom <- function(df) {
df$flag <- (df$depression == "Yes" | df$anxiety == "Yes")
ggplot(df, aes(age, cgpa_num, flag = flag)) +
geom_mentalhealth() +
labs(
title    = "Visualisation avec geom_mentalhealth()",
subtitle = "Géom ggproto personnalisé — croix rouge = dépression OU anxiété",
x = "Âge", y = "CGPA"
) +
theme_dash()
}
runApp()
# =====================================================
# TAUX DE DEPRESSION
# =====================================================
calculate_depression_rate <- function(df){
round(
mean(df$depression == "Yes",
na.rm = TRUE) * 100,
1
)
}
# =====================================================
# TAUX D'ANXIETE
# =====================================================
calculate_anxiety_rate <- function(df){
round(
mean(df$anxiety == "Yes",
na.rm = TRUE) * 100,
1
)
}
# =====================================================
# TAUX DE PANIC ATTACK
# =====================================================
calculate_panic_rate <- function(df){
round(
mean(df$panic == "Yes",
na.rm = TRUE) * 100,
1
)
}
# =====================================================
# CGPA MOYEN
# =====================================================
calculate_mean_cgpa <- function(df){
round(
mean(df$cgpa_num,
na.rm = TRUE),
2
)
}
# =====================================================
# NOMBRE D'ETUDIANTS
# =====================================================
count_students <- function(df){
nrow(df)
}
# =====================================================
# PROFILS A RISQUE
# =====================================================
get_risk_profiles <- function(df){
df %>%
filter(
depression == "Yes",
!is.na(cgpa_num),
cgpa_num < 2.5
)
}
# =====================================================
# ETUDIANTS ANXIEUX MAIS PERFORMANTS
# =====================================================
get_anxious_high_performers <- function(df){
df %>%
filter(
anxiety == "Yes",
cgpa_num >= 3
)
}
# =====================================================
# RESUME KPI
# =====================================================
summary_kpis <- function(df){
tibble(
Students = count_students(df),
Mean_CGPA = calculate_mean_cgpa(df),
Depression_Rate =
calculate_depression_rate(df),
Anxiety_Rate =
calculate_anxiety_rate(df),
Panic_Rate =
calculate_panic_rate(df)
)
}
runApp()
library(tidyverse)
# =====================================================
# CHARGEMENT
# =====================================================
data <- read.csv(
"data/Student_Mental_health.csv",
stringsAsFactors = FALSE
)
# =====================================================
# RENOMMAGE DES COLONNES
# =====================================================
names(data) <- c(
"timestamp",
"gender",
"age",
"course",
"year",
"cgpa",
"marital_status",
"depression",
"anxiety",
"panic",
"treatment"
)
# =====================================================
# VALEURS MANQUANTES
# =====================================================
data <- data %>%
filter(!is.na(age))
# =====================================================
# NETTOYAGE ANNEE
# =====================================================
data$year <- tolower(data$year)
data$year <- str_extract(
data$year,
"[1-4]"
)
data$year <- factor(
data$year,
levels = c("1","2","3","4"),
ordered = TRUE
)
# =====================================================
# NETTOYAGE CGPA
# =====================================================
cgpa_map <- c(
"0 - 1.99"    = 1.00,
"2.00 - 2.49" = 2.25,
"2.50 - 2.99" = 2.75,
"3.00 - 3.49" = 3.25,
"3.50 - 4.00" = 3.75
)
data$cgpa_num <- cgpa_map[data$cgpa]
data$cgpa_num <- as.numeric(data$cgpa_num)
data$cgpa <- factor(
data$cgpa,
ordered = TRUE
)
# =====================================================
# VARIABLES OUI/NON
# =====================================================
binary_vars <- c(
"depression",
"anxiety",
"panic",
"treatment"
)
for(v in binary_vars){
data[[v]] <- factor(
data[[v]],
levels = c("No","Yes")
)
}
# =====================================================
# GENRE
# =====================================================
data$gender <- factor(data$gender)
# =====================================================
# FILIERE
# =====================================================
data$course <- factor(data$course)
# =====================================================
# AGE
# =====================================================
data$age <- as.numeric(data$age)
# =====================================================
# PROFIL A RISQUE
# =====================================================
data <- data %>%
mutate(
risk_profile = case_when(
depression == "Yes" &
cgpa_num < 2.50 ~ "High Risk",
anxiety == "Yes" &
cgpa_num < 2.50 ~ "Moderate Risk",
TRUE ~ "Normal"
)
)
data$risk_profile <- factor(
data$risk_profile,
levels = c(
"Normal",
"Moderate Risk",
"High Risk"
)
)
# =====================================================
# STATISTIQUES RAPIDES
# =====================================================
n_students <- nrow(data)
mean_cgpa <- mean(
data$cgpa_num,
na.rm = TRUE
)
depression_rate <- mean(
data$depression == "Yes"
) * 100
anxiety_rate <- mean(
data$anxiety == "Yes"
) * 100
# =====================================================
# VERIFICATION
# =====================================================
str(data)
summary(data)
print(unique(data$cgpa))          # voir les valeurs exactes
print(table(is.na(data$cgpa_num))) # combien de NA
library(tidyverse)
# =====================================================
# CHARGEMENT
# =====================================================
data <- read.csv(
"data/Student_Mental_health.csv",
stringsAsFactors = FALSE
)
# =====================================================
# RENOMMAGE DES COLONNES
# =====================================================
names(data) <- c(
"timestamp",
"gender",
"age",
"course",
"year",
"cgpa",
"marital_status",
"depression",
"anxiety",
"panic",
"treatment"
)
# =====================================================
# VALEURS MANQUANTES
# =====================================================
data <- data %>%
filter(!is.na(age))
# =====================================================
# NETTOYAGE ANNEE
# =====================================================
data$year <- tolower(data$year)
data$year <- str_extract(
data$year,
"[1-4]"
)
data$year <- factor(
data$year,
levels = c("1","2","3","4"),
ordered = TRUE
)
# =====================================================
# NETTOYAGE CGPA
# =====================================================
data$cgpa_num <- case_when(
grepl("^0",     data$cgpa) ~ 1.00,
grepl("^2\\.0", data$cgpa) ~ 2.25,
grepl("^2\\.5", data$cgpa) ~ 2.75,
grepl("^3\\.0", data$cgpa) ~ 3.25,
grepl("^3\\.5", data$cgpa) ~ 3.75,
TRUE ~ NA_real_
)
data$cgpa_num <- as.numeric(data$cgpa_num)
# =====================================================
# VARIABLES OUI/NON
# =====================================================
binary_vars <- c(
"depression",
"anxiety",
"panic",
"treatment"
)
for(v in binary_vars){
data[[v]] <- factor(
data[[v]],
levels = c("No","Yes")
)
}
# =====================================================
# GENRE
# =====================================================
data$gender <- factor(data$gender)
# =====================================================
# FILIERE
# =====================================================
data$course <- factor(data$course)
# =====================================================
# AGE
# =====================================================
data$age <- as.numeric(data$age)
# =====================================================
# PROFIL A RISQUE
# =====================================================
data <- data %>%
mutate(
risk_profile = case_when(
depression == "Yes" &
cgpa_num < 2.50 ~ "High Risk",
anxiety == "Yes" &
cgpa_num < 2.50 ~ "Moderate Risk",
TRUE ~ "Normal"
)
)
data$risk_profile <- factor(
data$risk_profile,
levels = c(
"Normal",
"Moderate Risk",
"High Risk"
)
)
# =====================================================
# STATISTIQUES RAPIDES
# =====================================================
n_students <- nrow(data)
mean_cgpa <- mean(
data$cgpa_num,
na.rm = TRUE
)
depression_rate <- mean(
data$depression == "Yes"
) * 100
anxiety_rate <- mean(
data$anxiety == "Yes"
) * 100
# =====================================================
# VERIFICATION
# =====================================================
str(data)
summary(data)
print(unique(data$cgpa))          # voir les valeurs exactes
print(table(is.na(data$cgpa_num))) # combien de NA
runApp()
